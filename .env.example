# ========================================================
# WEB NASIR — PRODUCTION ENVIRONMENT VARIABLES (.env.example)
# Production CMS Storage: Netlify Blobs (@netlify/blobs, store: "webnasir", strong consistency)
# Student Auth & User Data: Firebase Auth + Cloud Firestore
# ========================================================

# 1. Server & Site Configuration
PORT=3000
NODE_ENV=production
SITE_URL=https://webnasir.dpdns.org

# 2. Gemini AI API Key (Server-side generation for Free Online Tools)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Admin Authentication Secret & Default Credentials
JWT_SECRET=replace_with_a_strong_64_char_secret_key
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin123

# 4. Indian Payment Gateway — Razorpay (INR: UPI, Cards, NetBanking, Wallets)
# Can be set via environment variables OR managed inside Admin Dashboard -> Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional International Gateway (Not required — app starts and runs without Stripe)
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=

# 5. Email / SMTP Notifications (Optional — can also be configured inside Admin Dashboard)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@webnasir.com
SMTP_PASS=
SMTP_FROM="Web Nasir <support@webnasir.com>"

# 6. Optional Self-Hosted / VPS Fallback Storage (DO NOT SET ON NETLIFY)
# Production Netlify Functions automatically use persistent Netlify Blobs.
# When self-hosted on a VPS/Docker, storage automatically defaults to `.netlify-blobs-data`.
# LOCAL_STORAGE_DIR=.netlify-blobs-data
